# Copy to .env. Never commit real credentials.
NTHEEMBA_APP_NAME=Ntheemba
NTHEEMBA_ENVIRONMENT=development
NTHEEMBA_VERSION=0.12.0
NTHEEMBA_API_PREFIX=/api/v1
NTHEEMBA_DOCS_ENABLED=true
NTHEEMBA_LOG_LEVEL=INFO

# Phase 11 observability
NTHEEMBA_TRACING_ENABLED=true
NTHEEMBA_TRACE_EXPORT_ENABLED=true
NTHEEMBA_TRACE_SAMPLE_RATE=1.0
NTHEEMBA_TRACE_INCLUDE_RUNNING=true
NTHEEMBA_TRACE_INCLUDE_ERROR_MESSAGES=false
NTHEEMBA_TRACE_ERROR_MESSAGE_MAX_LENGTH=250

# Authenticates the legacy/OpenWA gateway ingestion API.
NTHEEMBA_GATEWAY_SHARED_SECRET=replace-with-a-long-random-secret

# Phase 12 durable backends
NTHEEMBA_SESSION_BACKEND=redis
NTHEEMBA_CUSTOMER_BACKEND=postgres
NTHEEMBA_BUSINESS_BACKEND=postgres
NTHEEMBA_GATEWAY_QUEUE_BACKEND=redis
NTHEEMBA_REDIS_URL=redis://localhost:6379/0
NTHEEMBA_POSTGRES_DSN=postgresql://ntheemba:ntheemba_local_change_me@localhost:5432/ntheemba
NTHEEMBA_REDIS_KEY_PREFIX=ntheemba

# Runtime TTLs
NTHEEMBA_SESSION_TTL_SECONDS=604800
NTHEEMBA_SESSION_ARCHIVE_TTL_SECONDS=7776000
NTHEEMBA_DEDUPLICATION_TTL_SECONDS=604800
NTHEEMBA_IDEMPOTENCY_TTL_SECONDS=2592000
NTHEEMBA_LOCK_TTL_SECONDS=30
NTHEEMBA_LOCK_ACQUIRE_TIMEOUT_SECONDS=10
NTHEEMBA_GATEWAY_CLAIM_IDLE_SECONDS=60
NTHEEMBA_GATEWAY_MAX_DELIVERY_ATTEMPTS=5
NTHEEMBA_GATEWAY_STREAM_MAX_LENGTH=100000

# Durable customer-memory retention
NTHEEMBA_CUSTOMER_MESSAGE_RETENTION_DAYS=180
NTHEEMBA_CUSTOMER_SUMMARY_RETENTION_DAYS=730
NTHEEMBA_CUSTOMER_QUESTION_RETENTION_DAYS=730
NTHEEMBA_UNSUPPORTED_OBSERVATION_RETENTION_DAYS=365
NTHEEMBA_CROSS_BUSINESS_RECOGNITION_ENABLED=true

# Developer tools: local only unless protected with a token.
NTHEEMBA_DEV_TOOLS_ENABLED=true
NTHEEMBA_DEV_TOOLS_ALLOWED_NETWORKS=127.0.0.0/8,::1/128
NTHEEMBA_DEV_TOOLS_TOKEN=
