# Sample .env.example file for Ntheemba Auth Service

# This is an example of the environment variables required for the Ntheemba Auth Service.

# Database configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ntheemba_db

# JWT configuration
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# OTP configuration
OTP_EXPIRATION_MINUTES=5
SMS_API_KEY=your_sms_api_key
WHATSAPP_API_KEY=your_whatsapp_api_key

# Other configurations
DEBUG=True
HOST=0.0.0.0
PORT=8000