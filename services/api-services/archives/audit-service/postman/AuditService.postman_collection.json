{
  "info": {
    "name": "Audit Service",
    "_postman_id": "audit-service-collection",
    "description": "Collection for Audit Service endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [ "{{base_url}}" ],
          "path": [ "health" ]
        }
      },
      "response": []
    },
    {
      "name": "Ingest single audit event",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"service\": \"affiliate-service\",\n  \"event_type\": \"affiliate_registered\",\n  \"actor_id\": \"00000000-0000-0000-0000-000000000001\",\n  \"entity_type\": \"affiliate\",\n  \"entity_id\": \"11111111-1111-1111-1111-111111111111\",\n  \"payload\": { \"code\": \"AFF-XYZ123\", \"user_id\": \"00000000-0000-0000-0000-000000000001\" },\n  \"metadata\": { \"request_id\": \"req-1\", \"ip\": \"127.0.0.1\" }\n}"
        },
        "url": {
          "raw": "{{base_url}}/audit/log",
          "host": [ "{{base_url}}" ],
          "path": [ "audit", "log" ]
        }
      },
      "response": []
    },
    {
      "name": "Get audit by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/audit/{{audit_id}}",
          "host": [ "{{base_url}}" ],
          "path": [ "audit", "{{audit_id}}" ]
        }
      },
      "response": []
    },
    {
      "name": "Query audits",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/audit?service=affiliate-service&page=1&size=20",
          "host": [ "{{base_url}}" ],
          "path": [ "audit" ],
          "query": [
            { "key": "service", "value": "affiliate-service" },
            { "key": "page", "value": "1" },
            { "key": "size", "value": "20" }
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8290" },
    { "key": "audit_id", "value": "" }
  ]
}
