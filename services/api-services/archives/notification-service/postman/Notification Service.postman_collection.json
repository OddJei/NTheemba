{
  "info": {
    "name": "Notification Service",
    "_postman_id": "7f3c2f0a-0000-4a2e-9b15-000000000001",
    "description": "Postman collection for the Notification Service (local dev). Replace {{base_url}} if needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8285",
      "type": "string"
    },
    {
      "key": "audit_url",
      "value": "http://127.0.0.1:8290/audit/log",
      "type": "string"
    }
  ],
  "event": [],
  "item": [
    {
      "name": "Send Notification (SMS)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"user:42\",\n  \"channel\": \"sms\",\n  \"template\": \"welcome\",\n  \"payload\": { \"phone\": \"+1234567890\", \"message\": \"Hello from Postman\" }\n}"
        },
        "url": {
          "raw": "{{base_url}}/notification/send",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "notification",
            "send"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Send Notification (Email)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"user:123\",\n  \"channel\": \"email\",\n  \"template\": \"welcome\",\n  \"payload\": { \"subject\": \"Hello\", \"message\": \"Welcome!\" }\n}"
        },
        "url": {
          "raw": "{{base_url}}/notification/send",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "notification",
            "send"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Notification by ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/notification/:id",
          "host": ["{{base_url}}"],
          "path": ["notification", ":id"]
        }
      },
      "response": []
    },
    {
      "name": "Get Notifications by User",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/notification/user/:user_id",
          "host": ["{{base_url}}"],
          "path": ["notification", "user", ":user_id"]
        }
      },
      "response": []
    },
    {
      "name": "Create Template",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"welcome\",\n  \"channel\": \"email\",\n  \"content\": \"Hello {{user_name}}, welcome to our platform!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/notification/template",
          "host": ["{{base_url}}"],
          "path": ["notification", "template"]
        }
      },
      "response": []
    },
    {
      "name": "Get Template",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/notification/template/:name",
          "host": ["{{base_url}}"],
          "path": ["notification", "template", ":name"]
        }
      },
      "response": []
    },
    {
      "name": "Update Preferences",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"preferred_channel\": \"sms\",\n  \"opt_in\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/notification/preferences/:id",
          "host": ["{{base_url}}"],
          "path": ["notification", "preferences", ":id"]
        }
      },
      "response": []
    },
    {
      "name": "Get Preferences by User",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/notification/preferences/user/:user_id",
          "host": ["{{base_url}}"],
          "path": ["notification", "preferences", "user", ":user_id"]
        }
      },
      "response": []
    }
    ,
    {
      "name": "Send Audit Event (raw)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"service\": \"affiliate-service\",\n  \"event_type\": \"affiliate_registered\",\n  \"actor_id\": \"00000000-0000-0000-0000-000000000001\",\n  \"entity_type\": \"affiliate\",\n  \"entity_id\": \"11111111-1111-1111-1111-111111111111\",\n  \"payload\": { \"code\": \"AFF-XYZ123\", \"user_id\": \"00000000-0000-0000-0000-000000000001\" },\n  \"metadata\": { \"request_id\": \"req-1\", \"ip\": \"127.0.0.1\" }\n}"
        },
        "url": {
          "raw": "{{audit_url}}",
          "host": [ "{{audit_url}}" ],
          "path": []
        }
      },
      "response": []
    }
  ]
}
