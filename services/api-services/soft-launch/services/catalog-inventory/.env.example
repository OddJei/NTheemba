# MinIO / S3 settings for local soft-launch
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ntheemba
S3_REGION=us-east-1
S3_USE_SSL=0

# Database (optional override)
# DATABASE_URL=sqlite+aiosqlite:///./catalog_inventory.db

# Event source name
# EVENT_SOURCE=catalog-inventory

# Shared JWT secret for verifying msme-engine access tokens
MSME_JWT_SECRET=change-me
