"""
.env.example - Example environment configuration for ICE service

Copy this to .env and fill in real values for your environment.
"""

# Bot Session Service
BOT_SESSION_URL=http://bot-session:8000
ICE_BOT_SESSION_TIMEOUT=5.0

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_TIMEOUT=5.0

# Database
DATABASE_URL=postgresql+asyncpg://postgres:!ladybug!%23!@postgres:5432/ntheemba

# Backend Services
CATALOG_INVENTORY_URL=http://catalog-inventory:8520
CART_SERVICE_URL=http://cart:8530
PAYMENT_REVENUE_URL=http://payment-revenue:8590
ORDER_DELIVERY_URL=http://order-delivery:8560
AFFILIATE_ENGINE_URL=http://affiliate-engine:8510
MSME_ENGINE_URL=http://msme-engine:8500

# Logging
LOG_LEVEL=INFO
