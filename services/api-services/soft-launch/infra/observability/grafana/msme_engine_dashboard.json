          "expr": "sum by (route, status)(rate(http_requests_total{service=\"msme-engine\"}[5m]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ],
      "datasource": null
    },
    {
      "type": "graph",
      "title": "Request Latency (p95)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{service=\"msme-engine\"}[5m])))",
          "legendFormat": "{{route}} p95"
        }
      ],
      "datasource": null
    }
  ],
