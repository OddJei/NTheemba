# Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8080
NODE_ENV=development

# API Configuration
API_BASE_URL=http://api:8000
WHATSAPP_API_KEY=your-api-key-here

# Logging
LOG_LEVEL=info

# File Storage
QR_CODE_DIR=./qrcodes

# Session Management
SESSION_TIMEOUT=3600000

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=1000

# Database (future use)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ntheemba
DB_USER=ntheemba
DB_PASSWORD=password