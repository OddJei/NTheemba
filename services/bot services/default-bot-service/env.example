# Bot Service Environment Configuration
# Copy this file to .env and update with your actual values

# Service Configuration
SERVICE_NAME=default-bot-service
SERVICE_VERSION=1.0.0
SERVICE_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL=3600

# API Service Base URLs (Ports 8100-8199)
AUTH_SERVICE_URL=http://localhost:8100
SESSION_SERVICE_URL=http://localhost:8101
EVENT_SERVICE_URL=http://localhost:8102
NOTIFICATION_SERVICE_URL=http://localhost:8103
CATALOG_SERVICE_URL=http://localhost:8104
ORDER_SERVICE_URL=http://localhost:8105
PAYMENT_SERVICE_URL=http://localhost:8106
INVENTORY_SERVICE_URL=http://localhost:8107
USER_SERVICE_URL=http://localhost:8108
BUSINESS_SERVICE_URL=http://localhost:8109
AFFILIATE_SERVICE_URL=http://localhost:8110
ANALYTICS_SERVICE_URL=http://localhost:8111
REPORT_SERVICE_URL=http://localhost:8112

# Queue Configuration
DEFAULT_QUEUE=default_queue
REPLY_QUEUE=reply_queue
EVENT_QUEUE=bot_events
ERROR_QUEUE=error_queue

# Tree Configuration
TREE_CACHE_TTL=1800
TREE_LOAD_TIMEOUT=30
DEFAULT_TREE=public_catalog_tree

# Handler Configuration
HANDLER_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=1

# Event Configuration
EVENT_BATCH_SIZE=100
EVENT_FLUSH_INTERVAL=5
EVENT_RETRY_ATTEMPTS=3

# Security Configuration
API_KEY_HEADER=X-API-Key
API_KEY_VALUE=your-api-key-here
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRY=3600

# Monitoring Configuration
HEALTH_CHECK_INTERVAL=30
METRICS_ENABLED=true
TRACING_ENABLED=true

# External Service Timeouts (seconds)
AUTH_SERVICE_TIMEOUT=10
SESSION_SERVICE_TIMEOUT=10
EVENT_SERVICE_TIMEOUT=15
NOTIFICATION_SERVICE_TIMEOUT=20
CATALOG_SERVICE_TIMEOUT=15
ORDER_SERVICE_TIMEOUT=20
PAYMENT_SERVICE_TIMEOUT=30
INVENTORY_SERVICE_TIMEOUT=10
USER_SERVICE_TIMEOUT=10
BUSINESS_SERVICE_TIMEOUT=15
AFFILIATE_SERVICE_TIMEOUT=15
ANALYTICS_SERVICE_TIMEOUT=20
REPORT_SERVICE_TIMEOUT=30

