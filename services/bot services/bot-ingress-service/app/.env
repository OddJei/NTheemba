INGRESS_DLQ_STREAM=ingress_dlq
INGRESS_IDEMPOTENCY_TTL=3600
INGRESS_SESSION_TIMEOUT_SECONDS=1800
HTTP_TIMEOUT_SECONDS=10.0
BOT_SERVICE_URL=https://26d74b84-8b22-46b9-8a05-80d02417526c.mock.pstmn.io
