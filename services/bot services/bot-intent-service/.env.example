# Bot Intent Service - example environment

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_DECODE_RESPONSES=True

# Streams
INTENT_REQUESTS_STREAM=intent:requests
INTENT_RESULTS_STREAM=intent:results
INTENT_DLQ_STREAM=intent:dlq
INTENT_STREAM_MAXLEN=10000

# Worker
INTENT_WORKER_ENABLED=True
INTENT_CONSUMER_GROUP=intent-workers
INTENT_CONSUMER_NAME=intent-service
INTENT_READ_COUNT=25
INTENT_READ_BLOCK_MS=1000
INTENT_MAX_ATTEMPTS=2
INTENT_IDEMPOTENCY_TTL=3600

# Gemini (optional)
# Enable only when you set a real API key.
INTENT_GEMINI_ENABLED=False
INTENT_GEMINI_MODEL=gemini-flash
INTENT_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
INTENT_GEMINI_API_KEY=
INTENT_GEMINI_TIMEOUT_SECONDS=15.0
